#!/usr/bin/env python3
"""Keep the Lenovo VPC FAST fan mode alive while external power is present."""

from __future__ import annotations

import argparse
import signal
import sys
import time
from pathlib import Path


FAN_MODE = Path(
    "/sys/devices/pci0000:00/0000:00:14.3/PNP0C09:00/"
    "VPC2004:00/fan_mode"
)
POWER_SUPPLY = Path("/sys/class/power_supply")
INTERVAL_SECONDS = 8.5
CONFIRM_TIMEOUT_SECONDS = 1.0
CONFIRM_POLL_SECONDS = 0.005


class FanControllerError(RuntimeError):
    pass


def read_text(path: Path) -> str:
    return path.read_text(encoding="ascii").strip()


def write_mode(value: int) -> None:
    FAN_MODE.write_text(f"{value}\n", encoding="ascii")


def on_ac_power() -> bool:
    for supply in POWER_SUPPLY.iterdir():
        type_path = supply / "type"
        online_path = supply / "online"
        if not type_path.is_file() or not online_path.is_file():
            continue
        try:
            supply_type = read_text(type_path)
            online = read_text(online_path)
        except OSError:
            continue
        if supply_type in {"Mains", "USB", "USB_C"} and online == "1":
            return True
    return False


def require_ac_power() -> None:
    if not on_ac_power():
        raise FanControllerError("external power is not connected")


def confirm_normal(normal_state: str) -> None:
    deadline = time.monotonic() + CONFIRM_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        require_ac_power()
        write_mode(0)
        if read_text(FAN_MODE) == normal_state:
            return
        time.sleep(CONFIRM_POLL_SECONDS)
    raise FanControllerError("NORMAL fan-mode readback was not confirmed")


def confirm_fast(normal_state: str) -> str:
    deadline = time.monotonic() + CONFIRM_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        require_ac_power()
        write_mode(1)
        state = read_text(FAN_MODE)
        if state != normal_state:
            return state
        time.sleep(CONFIRM_POLL_SECONDS)
    raise FanControllerError("FAST fan-mode readback was not confirmed")


def wait_for_retrigger() -> None:
    deadline = time.monotonic() + INTERVAL_SECONDS
    while True:
        require_ac_power()
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return
        time.sleep(min(remaining, 0.05))


def run() -> int:
    if not FAN_MODE.is_file():
        raise FanControllerError(f"fan interface is missing: {FAN_MODE}")

    require_ac_power()
    write_mode(0)
    time.sleep(0.2)
    normal_state = read_text(FAN_MODE)
    confirm_normal(normal_state)
    fast_state = confirm_fast(normal_state)
    print(
        f"max-fan active: NORMAL={normal_state}, FAST={fast_state}, "
        f"retrigger={INTERVAL_SECONDS}s",
        flush=True,
    )

    while True:
        wait_for_retrigger()
        confirm_normal(normal_state)
        fast_state = confirm_fast(normal_state)
        print(f"max-fan retriggered: FAST={fast_state}", flush=True)


def reset() -> int:
    write_mode(0)
    print("restored fan_mode=0", flush=True)
    return 0


def stop_on_signal(signum: int, _frame: object) -> None:
    print(f"stopping on signal {signum}", flush=True)
    raise SystemExit(0)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--reset", action="store_true", help="write fan_mode=0 and exit"
    )
    args = parser.parse_args()

    if args.reset:
        return reset()

    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, stop_on_signal)

    try:
        return run()
    except FanControllerError as error:
        print(f"max-fan stopped: {error}", file=sys.stderr, flush=True)
        return 1
    finally:
        try:
            reset()
        except OSError as error:
            print(
                f"failed to restore fan_mode=0: {error}",
                file=sys.stderr,
                flush=True,
            )


if __name__ == "__main__":
    raise SystemExit(main())
